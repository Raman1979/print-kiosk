# The public URL of your deployed server (no trailing slash)
SERVER_URL=https://print-kiosk-server-d4uq.onrender.com

# Must match AGENT_API_KEY on the server exactly (Render dashboard -> your
# service -> Environment tab)
AGENT_API_KEY=paste-the-same-key-from-render-here

# How often to check for new jobs, in seconds
POLL_INTERVAL_SECONDS=5

# ---- Printers ----
# Exact Windows printer names (Settings -> Printers & scanners -> copy the
# name exactly, including spaces). Jobs marked "color" go to
# PRINTER_NAME_COLOR; everything else goes to PRINTER_NAME_BW.
# If you only have one printer, set both to the same name.
PRINTER_NAME_BW=Canon iR2870
PRINTER_NAME_COLOR=EPSON L3150 Series

# ---- Paper size + duplex (double-sided) control ----
# Optional but recommended: download the free, portable SumatraPDF.exe
# (no installation needed) from https://www.sumatrapdfreader.org/download-free-pdf-viewer
# and save it as print-agent/tools/SumatraPDF.exe
# Without it, PDFs still print fine, but the paper size and "both sides"
# options the customer picks will be ignored (the printer's own current
# default settings are used instead).
SUMATRA_PATH=./tools/SumatraPDF.exe
