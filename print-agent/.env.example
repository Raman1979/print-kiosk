# The public URL of your deployed server (no trailing slash)
SERVER_URL=https://print-kiosk-server-d4uq.onrender.com

# Must match AGENT_API_KEY on the server exactly (Render dashboard -> your
# service -> Environment tab)
AGENT_API_KEY=paste-the-same-key-from-render-here

# How often to check for new jobs, in seconds
POLL_INTERVAL_SECONDS=5

# Name of the Windows printer to use. Leave blank to use whatever printer
# is currently set as the Windows default.
PRINTER_NAME=
