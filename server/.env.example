# Port the Express server listens on
PORT=4000

# Max upload size in megabytes
MAX_FILE_SIZE_MB=25

# Shared secret the local print agent must send to poll/download/delete jobs
# (prevents random internet traffic from pulling customer documents)
AGENT_API_KEY=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to hit the upload endpoint
# (your public kiosk page URL)
CORS_ORIGIN=*
